{
  "name": "equi-api-node-postgres",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de caballos con HTTP nativo de Node.js y PostgreSQL",
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "migrate": "node scripts/migrate.js",
    "test:migrations": "node --test tests/migrations/*.test.js",
    "test:public": "node scripts/verify-public.js",
    "test:integration": "node --test tests/integration/*.test.js"
  },
  "dependencies": { "pg": "8.16.3" }
}
